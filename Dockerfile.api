# Dockerfile.api — omega-api (Go Connect-RPC server)
FROM golang:1.25-bookworm AS builder

WORKDIR /src

COPY go.mod go.sum ./
RUN go mod download

COPY . .
RUN CGO_ENABLED=0 go build -o /omega-api ./cmd/omega-api

# ── Runtime ────────────────────────────────────────────────────────────────────
FROM debian:bookworm-slim

RUN apt-get update && apt-get install -y --no-install-recommends curl \
    && rm -rf /var/lib/apt/lists/*

RUN mkdir -p /data

COPY --from=builder /omega-api /omega-api

EXPOSE 8080

ENTRYPOINT ["/omega-api"]
