      "targets": [
        {"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "omega_signal_value{signal_name=\"composite\"}", "legendFormat": "{{symbol}}"}
      ]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
