      "title": "Episodic Memories",
      "type": "stat",
      "targets": [{"datasource": {"type": "prometheus", "uid": "prometheus"}, "expr": "omega_memory_entries_total{memory_type=\"episodic\"}", "legendFormat": ""}]
    },
    {
      "datasource": {"type": "prometheus", "uid": "prometheus"},
