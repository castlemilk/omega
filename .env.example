# .env.example
# Copy to .env and fill in values. Never commit .env to source control.

# ── LLM Brain API Keys ─────────────────────────────────────────────────────────
# Use ANTHROPIC_API_KEY or its alias CLAUDE_API_KEY — both are accepted.
ANTHROPIC_API_KEY=
# CLAUDE_API_KEY=  # alias for ANTHROPIC_API_KEY (accepted as fallback)
OPENAI_API_KEY=
DEEPSEEK_API_KEY=
GOOGLE_API_KEY=

# ── Ollama (local LLMs, no key needed) ─────────────────────────────────────────
OLLAMA_HOST=http://localhost:11434

# ── Brain configuration ─────────────────────────────────────────────────────────
# Provider: "anthropic" | "openai" | "deepseek" | "ollama" | "none"
OMEGA_BRAIN_PROVIDER=none
OMEGA_BRAIN_MODEL=
OMEGA_BRAIN_TEMPERATURE=0.7
OMEGA_BRAIN_MAX_TOKENS=1024

# ── PostgreSQL credentials ──────────────────────────────────────────────────────
# PRODUCTION: Set these to real values. Never use the dev defaults in prod.
POSTGRES_DB=omega
POSTGRES_USER=omega
POSTGRES_PASSWORD=omega

# ── PostgreSQL connection ───────────────────────────────────────────────────────
# All Omega data is stored in a single Postgres database.
# Format: postgres://user:password@host:port/dbname?sslmode=disable
DATABASE_URL=postgres://omega:omega@localhost:5432/omega?sslmode=disable

# Test database (used by Go + Python test suites). Set to run DB tests.
TEST_DATABASE_URL=postgres://omega:omega@localhost:5432/omega_test?sslmode=disable

# ── Monitoring ──────────────────────────────────────────────────────────────────
OMEGA_LOG_LEVEL=INFO
OMEGA_JSON_LOGS=true
OMEGA_LOG_FILE=
OMEGA_METRICS_PORT=9090
OMEGA_API_BASE_URL=http://omega-api:8080

# ── Heartbeat / alignment ───────────────────────────────────────────────────────
OMEGA_HEALTH_THRESHOLD=0.6
OMEGA_IMPROVEMENT_INTERVAL=3
OMEGA_MAX_IMPROVEMENT_CYCLES=10

# ── External data sources ───────────────────────────────────────────────────────
# FRED (Federal Reserve Economic Data) — free API key from:
# https://fred.stlouisfed.org/docs/api/api_key.html
# Required for macro_signals (M2, Fed Funds, Real Yields, Yield Curve, DXY, Net Liquidity)
FRED_API_KEY=

# ── Data ────────────────────────────────────────────────────────────────────────
# Comma-separated list of trading pairs (leave blank for defaults)
OMEGA_SYMBOLS=
OMEGA_PROVIDERS=
OMEGA_FETCH_INTERVAL_DAYS=90

# ── Adversarial rings ───────────────────────────────────────────────────────────
OMEGA_ADVERSARIAL_RINGS=
OMEGA_VETO_THRESHOLD=0.8
OMEGA_CHALLENGE_TIMEOUT_SEC=5.0

# ── Optional YAML config path ───────────────────────────────────────────────────
# OMEGA_CONFIG=omega.yml

# ── Victoria / Market Data API Keys (all optional — public APIs work without) ────
# Binance authenticated endpoints (higher rate limits, account data)
BINANCE_API_KEY=
BINANCE_API_SECRET=

# Deribit authenticated endpoints (private order flow, account data)
# Public API (options IV, DVOL index) works without credentials
DERIBIT_CLIENT_ID=
DERIBIT_CLIENT_SECRET=

# CoinGlass liquidation cascade data ($29/mo — graceful degradation without)
COINGLASS_API_KEY=

# Unusual Whales — options flow, dark pool, congressional trading, IV rank
# 100+ endpoints covering market microstructure intelligence
# API key from: https://unusualwhales.com/settings/api-dashboard
# Pricing: https://unusualwhales.com/pricing?product=api (~$250/mo full historical)
# Without key: all UW signals return neutral with confidence=0.0 (graceful degradation)
UW_API_KEY=

# ── Polymarket CLOB Trading ──────────────────────────────────────────────────────
# EIP-712 private key for signing Polymarket CLOB orders
# WARNING: keep this secret — it controls on-chain funds
POLYMARKET_PRIVATE_KEY=

# ── Credential store ─────────────────────────────────────────────────────────────
# Optional: point to a non-default .env file location
# OMEGA_ENV_FILE=/path/to/secrets.env
