# OS / editor noise
.DS_Store
data/.fuse_hidden*

# Local analysis reports
code-quality-report-*.md

# V219: SQLite WAL sidecars for the frozen macro cache (never commit)
data/macro_cache.db-shm
data/macro_cache.db-wal

# V220: ephemeral training-run artifacts. These are produced by background
# determinism/grid runs and must NOT enter the index — a background run writing
# them while a foreground session commits is the index-contention class that
# wedged sessions across V210–V220.
#
# Training run outputs (generated, never commit). The ONLY tracked data/ files
# are the curated inputs: data/snapshots/*.json, data/frozen_advanced_signals.json,
# data/.cache_manifest.json, data/macro_cache.db, data/frozen_funding_cache.json.
# Per-run V### outputs (results/trades/progress/attribution/contribs/audit dirs)
# are transcribed into the training_log/V###.md entry and never tracked raw.
data/v[0-9]*_*.json
data/v[0-9]*_*.jsonl
data/v[0-9]*_*.csv
data/v[0-9]*_*.log
data/v[0-9]*_audit/
data/live_paper/
data/v[0-9]*_pids.txt
data/v[0-9]*_grid_summary.txt
data/.v[0-9]*
# V228 resiliency #3: runtime session-continuity manifest (regenerated per session)
data/SESSION_STATE.json
# determinism replicate dirs + grid logs (broader, non v-anchored ephemerals)
data/*_determinism/
# distributional-grid output dirs (V231+); only matters when OMEGA_AUDIT_OUTPUT_DIR
# is unset and audit output falls back to data/ — external mounts live outside the repo
data/v[0-9]*_dist/
data/v[0-9]*_grid.log
# misc per-run scratch (driver .out logs, single-pid files, DONE markers,
# interim finding notes) — all generated, never commit
data/v[0-9]*.out
data/v[0-9]*_pid.txt
data/v[0-9]*_DONE.txt
data/v[0-9]*_interim_finding.md
data/v[0-9]*_grid_pid.txt
SESSION_NOTES.md

# V240 reasoning layer: nested harness repo holds LLM API tokens (Kimi/GLM);
# never commit it into omega.
harness/
